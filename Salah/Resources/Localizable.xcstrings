    "Salah" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সালাহ"
          }
        }
      }
    },
    "Salah collects the minimum information required for prayer timings and remains useful when optional permissions are declined." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah নামাজের সময়ের জন্য প্রয়োজনীয় ন্যূনতম তথ্য সংগ্রহ করে এবং ঐচ্ছিক অনুমতি না দিলেও কার্যকর থাকে।"
          }
        }
      }
    },
    "Salah is free, has no advertising, and does not require an account." : {
      "comment" : "A footer for the More screen that describes the benefits of using Salah.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah বিনামূল্যের, বিজ্ঞাপনমুক্ত এবং কোনো অ্যাকাউন্টের প্রয়োজন নেই।"
          }
        }
      }
    },
    "Salah records your reflection only. It never collects or processes donations." : {
      "comment" : "A description of how data is collected and used by the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah শুধু আপনার ব্যক্তিগত পর্যালোচনা রেকর্ড করে। এটি কখনো দান সংগ্রহ বা প্রক্রিয়া করে না।"
          }
        }
      }
    },
    "Salah retrieves one approximate coordinate and calculates prayer times on this device. Background tracking and location transmission are not used." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah একটি আনুমানিক স্থানাঙ্ক নেয় এবং এই ডিভাইসে নামাজের সময় গণনা করে। ব্যাকগ্রাউন্ড ট্র্যাকিং বা লোকেশন পাঠানো হয় না।"
          }
        }
      }
    },
    "Salah uses a one-time location request to calculate prayer times on this device. It does not transmit or track your location in the background. You can choose a district instead." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah এই ডিভাইসে নামাজের সময় গণনার জন্য একবার লোকেশন চায়। এটি ব্যাকগ্রাউন্ডে আপনার লোকেশন পাঠায় বা ট্র্যাক করে না। চাইলে এর বদলে একটি জেলা বেছে নিতে পারেন।"
          }
        }
      }
    },
